# Ключи Яндекс (Консоль разработчика: https://developer.tech.yandex.ru/)
#
# Скопируйте этот файл в .env и впишите свои ключи.
# JavaScript API — для отрисовки карт в приложении (маркеры, панорамы).
EXPO_PUBLIC_YANDEX_MAPS_API_KEY=

# Геокодер (HTTP API) — для превращения адреса в координаты.
EXPO_PUBLIC_YANDEX_GEOCODER_API_KEY=

# Supabase (понадобится, когда переключите USE_MOCK = false в src/config/index.ts)
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY